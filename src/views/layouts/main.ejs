<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SimplyDiagnostic LIS - <%= typeof title !== 'undefined' ? title : 'Dashboard' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app">
    <nav class="sidebar">
      <div class="sidebar-header">
        <h2>SimplyDiagnostic</h2>
        <span class="sidebar-subtitle">LIS</span>
      </div>
      <ul class="nav-menu">
        <li><a href="/dashboard" class="nav-link">Dashboard</a></li>
        <li><a href="/patients" class="nav-link">Patients</a></li>
        <li><a href="/orders" class="nav-link">Lab Orders</a></li>
        <li><a href="/samples" class="nav-link">Samples</a></li>
        <li><a href="/billing" class="nav-link">Billing</a></li>
        <li><a href="/settings" class="nav-link">Settings</a></li>
      </ul>
      <div class="sidebar-footer">
        <span class="user-name"><%= user.full_name %></span>
        <span class="user-role"><%= user.role %></span>
        <a href="/logout" class="btn btn-sm btn-outline">Logout</a>
      </div>
    </nav>
    <main class="content">
      <%- body %>
    </main>
  </div>
  <script src="/js/app.js"></script>
</body>
</html>
