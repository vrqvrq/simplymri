<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SimplyDiagnostic LIS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
</head>
<body>
  <button class="mobile-menu-btn">&#9776;</button>
  <div class="app">
    <nav class="sidebar">
      <div class="sidebar-header">
        <h2>SimplyDiagnostic</h2>
        <span class="sidebar-subtitle">Laboratory</span>
      </div>
      <ul class="nav-menu">
        <li><a href="/dashboard" class="nav-link">Dashboard</a></li>
        <li><a href="/patients" class="nav-link">Patients</a></li>
        <li><a href="/orders" class="nav-link">Lab Orders</a></li>
        <li><a href="/worklist" class="nav-link">Worklist</a></li>
        <li><a href="/samples" class="nav-link">Samples</a></li>
        <li><a href="/billing" class="nav-link">Billing</a></li>
        <li><a href="/tests" class="nav-link">Test Catalog</a></li>
        <li><a href="/physicians" class="nav-link">Physicians</a></li>
        <li><a href="/settings" class="nav-link">Settings</a></li>
      </ul>
      <div class="sidebar-footer">
        <span class="user-name"><%= user.full_name %></span>
        <span class="user-role"><%= user.role %></span>
        <div class="sidebar-actions">
          <button class="theme-toggle">Dark Mode</button>
          <a href="/logout" class="btn btn-sm btn-outline" style="color:#94a3b8;border-color:rgba(255,255,255,0.1)">Logout</a>
        </div>
      </div>
    </nav>
    <main class="content">
      <!-- Notification Bell -->
      <div class="topbar">
        <div class="keyboard-hint">Press <kbd>?</kbd> for shortcuts</div>
        <div class="notification-bell" id="notification-bell">
          <button class="bell-btn" onclick="toggleNotifications()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
            <span class="bell-count" id="bell-count" style="display:none">0</span>
          </button>
          <div class="notification-dropdown" id="notification-dropdown">
            <div class="notification-header">
              <strong>Notifications</strong>
              <button class="btn btn-sm" onclick="markAllRead()">Mark all read</button>
            </div>
            <div class="notification-list" id="notification-list">
              <div class="text-center" style="padding:20px;color:var(--text-muted)">Loading...</div>
            </div>
          </div>
        </div>
      </div>
