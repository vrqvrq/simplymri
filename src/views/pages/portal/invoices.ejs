<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Invoices - SimplyDiagnostic Portal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/portal.css">
</head>
<body>
  <nav class="portal-nav">
    <div class="portal-nav-inner">
      <a href="/portal" class="portal-logo">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
        SimplyDiagnostic
      </a>
      <div class="portal-nav-links">
        <a href="/portal" class="portal-nav-link">Dashboard</a>
        <a href="/portal/mri" class="portal-nav-link">MRI Studies</a>
        <a href="/portal/invoices" class="portal-nav-link active">Invoices</a>
        <a href="/portal/education" class="portal-nav-link">Education</a>
        <a href="/portal/profile" class="portal-nav-link">Profile</a>
      </div>
      <div class="portal-nav-user">
        <span class="portal-user-name"><%= patient.first_name %> <%= patient.last_name %></span>
        <a href="/portal/logout" class="portal-btn portal-btn-outline portal-btn-sm">Logout</a>
      </div>
    </div>
  </nav>

  <div class="portal-container">
    <div class="portal-breadcrumb">
      <a href="/portal" class="portal-link">Dashboard</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      <span>Invoices</span>
    </div>

    <div class="portal-page-header">
      <h1>Invoices</h1>
      <p>View your billing history and outstanding invoices</p>
    </div>

    <% if (invoices.length === 0) { %>
      <div class="portal-empty-hero">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        <h3>No invoices</h3>
        <p>You don't have any invoices yet.</p>
      </div>
    <% } else { %>
      <%
        const unpaid = invoices.filter(i => i.status === 'unpaid');
        const paid = invoices.filter(i => i.status !== 'unpaid');
      %>

      <% if (unpaid.length > 0) { %>
      <div class="portal-section">
        <h2 class="portal-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Outstanding (<%= unpaid.length %>)
        </h2>
        <div class="portal-results-table-wrap">
          <table class="portal-results-table">
            <thead>
              <tr>
                <th>Invoice #</th>
                <th>Order</th>
                <th>Date</th>
                <th>Amount</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% unpaid.forEach(inv => { %>
                <tr class="flagged-row">
                  <td><strong><%= inv.invoice_number %></strong></td>
                  <td><%= inv.order_number %></td>
                  <td><%= new Date(inv.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
                  <td class="result-value">$<%= parseFloat(inv.total_amount || 0).toFixed(2) %></td>
                  <td><span class="result-flag flag-high">Unpaid</span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <% } %>

      <% if (paid.length > 0) { %>
      <div class="portal-section">
        <h2 class="portal-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          Payment History (<%= paid.length %>)
        </h2>
        <div class="portal-results-table-wrap">
          <table class="portal-results-table">
            <thead>
              <tr>
                <th>Invoice #</th>
                <th>Order</th>
                <th>Date</th>
                <th>Amount</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% paid.forEach(inv => { %>
                <tr>
                  <td><%= inv.invoice_number %></td>
                  <td><%= inv.order_number %></td>
                  <td><%= new Date(inv.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
                  <td class="result-value">$<%= parseFloat(inv.total_amount || 0).toFixed(2) %></td>
                  <td><span class="result-flag flag-normal"><%= inv.status.charAt(0).toUpperCase() + inv.status.slice(1) %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <% } %>
    <% } %>

    <div class="portal-back-link">
      <a href="/portal" class="portal-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to Dashboard
      </a>
    </div>
  </div>

  <footer class="portal-footer">
    <p>&copy; <%= new Date().getFullYear() %> SimplyDiagnostic Laboratory. All rights reserved.</p>
  </footer>
</body>
</html>
