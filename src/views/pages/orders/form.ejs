<%- include('../../partials/header') %>

<div class="page-header">
  <h1>New Lab Order</h1>
  <a href="/orders" class="btn btn-outline">Back</a>
</div>

<div class="card">
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <form method="POST" action="/orders">
    <div class="form-row">
      <div class="form-group">
        <label>Patient *</label>
        <select name="patient_id" required>
          <option value="">Select patient...</option>
          <% patients.forEach(function(p) { %>
            <option value="<%= p.id %>" <%= String(selectedPatient) === String(p.id) ? 'selected' : '' %>><%= p.last_name %>, <%= p.first_name %> (<%= p.patient_id %>)</option>
          <% }); %>
        </select>
      </div>
      <div class="form-group">
        <label>Ordering Physician</label>
        <input type="text" name="ordering_physician" value="<%= order ? order.ordering_physician || '' : '' %>">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Priority</label>
        <select name="priority">
          <option value="routine">Routine</option>
          <option value="urgent">Urgent</option>
          <option value="stat">STAT</option>
        </select>
      </div>
    </div>
    <div class="form-group">
      <label>Clinical Notes</label>
      <textarea name="clinical_notes" rows="2"><%= order ? order.clinical_notes || '' : '' %></textarea>
    </div>

    <h3>Select Tests *</h3>
    <div class="test-catalog">
      <% let currentCat = ''; %>
      <% tests.forEach(function(t) { %>
        <% if (t.category !== currentCat) { currentCat = t.category; %>
          <h4 class="test-category"><%= currentCat %></h4>
        <% } %>
        <label class="test-option">
          <input type="checkbox" name="test_ids" value="<%= t.id %>">
          <span class="test-name"><%= t.name %> (<%= t.code %>)</span>
          <span class="test-price">$<%= t.price.toFixed(2) %></span>
        </label>
      <% }); %>
    </div>

    <button type="submit" class="btn btn-primary">Create Order</button>
  </form>
</div>

<%- include('../../partials/footer') %>
