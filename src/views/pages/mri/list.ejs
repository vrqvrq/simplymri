<% const title = 'MRI Studies' %>
<%- include('../../layouts/main', { body: `
<div class="page-header">
  <div>
    <h1>MRI Studies</h1>
    <p>Manage MRI imaging studies</p>
  </div>
  <a href="/mri/new" class="btn btn-primary">+ New MRI Study</a>
</div>

<div class="filters">
  <a href="/mri" class="btn btn-sm ${status === '' ? 'btn-primary' : 'btn-outline'}">All</a>
  <a href="/mri?status=scheduled" class="btn btn-sm ${status === 'scheduled' ? 'btn-primary' : 'btn-outline'}">Scheduled</a>
  <a href="/mri?status=in_progress" class="btn btn-sm ${status === 'in_progress' ? 'btn-primary' : 'btn-outline'}">In Progress</a>
  <a href="/mri?status=completed" class="btn btn-sm ${status === 'completed' ? 'btn-primary' : 'btn-outline'}">Completed</a>
</div>

<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th>Study ID</th>
        <th>Patient</th>
        <th>Body Part</th>
        <th>Modality</th>
        <th>Physician</th>
        <th>Status</th>
        <th>Report</th>
        <th>Date</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      ${studies.map(s => `
        <tr>
          <td><strong>${s.study_id}</strong></td>
          <td>${s.first_name} ${s.last_name} <small style="color:#888">(${s.pid})</small></td>
          <td>${s.body_part}</td>
          <td>${s.modality} ${s.contrast !== 'without' ? '(+C)' : ''}</td>
          <td>${s.ordering_physician || '-'}</td>
          <td><span class="badge badge-${s.status === 'completed' ? 'success' : s.status === 'in_progress' ? 'warning' : 'info'}">${s.status}</span></td>
          <td><span class="badge badge-${s.report_status === 'final' ? 'success' : s.report_status === 'draft' ? 'warning' : 'muted'}">${s.report_status || 'none'}</span></td>
          <td>${s.performed_date || s.scheduled_date || '-'}</td>
          <td><a href="/mri/${s.id}" class="btn btn-sm btn-outline">View</a></td>
        </tr>
      `).join('')}
      ${studies.length === 0 ? '<tr><td colspan="9" style="text-align:center;padding:40px;color:#888">No MRI studies found</td></tr>' : ''}
    </tbody>
  </table>
</div>
` }) %>
