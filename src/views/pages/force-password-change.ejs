<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SimplyDiagnostic LIS - Change Password</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-page">
  <div class="login-container">
    <div class="login-card">
      <div class="login-header">
        <h1>SimplyDiagnostic</h1>
        <p>Password Change Required</p>
      </div>
      <p style="margin-bottom: 1rem; color: #666;">You must change your password before continuing.</p>
      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <form method="POST" action="/force-password-change">
        <div class="form-group">
          <label for="new_password">New Password</label>
          <input type="password" id="new_password" name="new_password" required autofocus>
          <small style="color: #888;">Min 8 chars, with uppercase, lowercase, and a number</small>
        </div>
        <div class="form-group">
          <label for="confirm_password">Confirm Password</label>
          <input type="password" id="confirm_password" name="confirm_password" required>
        </div>
        <button type="submit" class="btn btn-primary btn-full">Change Password</button>
      </form>
    </div>
  </div>
</body>
</html>
