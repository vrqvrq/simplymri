<%- include('../../partials/header') %>

<div class="page-header">
  <h1><%= test && test.id ? 'Edit' : 'Add' %> Test</h1>
  <a href="/tests" class="btn btn-outline">Back</a>
</div>

<div class="card">
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <form method="POST" action="<%= test && test.id ? '/tests/' + test.id : '/tests' %>">
    <div class="form-row">
      <div class="form-group">
        <label>Test Code * (e.g. GLU, CBC, HGB)</label>
        <input type="text" name="code" value="<%= test ? test.code || '' : '' %>" required placeholder="e.g. BILI" style="text-transform:uppercase">
      </div>
      <div class="form-group">
        <label>Test Name *</label>
        <input type="text" name="name" value="<%= test ? test.name || '' : '' %>" required placeholder="e.g. Total Bilirubin">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Category *</label>
        <select name="category" id="category-select">
          <option value="">Select or type new below...</option>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat %>" <%= test && test.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% }); %>
        </select>
      </div>
      <div class="form-group">
        <label>Or Create New Category</label>
        <input type="text" name="new_category" placeholder="e.g. Microbiology">
      </div>
    </div>

    <div class="form-group">
      <label>Description</label>
      <input type="text" name="description" value="<%= test ? test.description || '' : '' %>" placeholder="Brief description of the test">
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Sample Type *</label>
        <select name="sample_type" required>
          <option value="">Select...</option>
          <% ['Blood (EDTA)', 'Blood (Serum)', 'Blood (Citrate)', 'Urine', 'Stool', 'Swab', 'CSF', 'Other'].forEach(function(st) { %>
            <option value="<%= st %>" <%= test && test.sample_type === st ? 'selected' : '' %>><%= st %></option>
          <% }); %>
        </select>
      </div>
      <div class="form-group">
        <label>Unit (e.g. mg/dL, U/L, %)</label>
        <input type="text" name="unit" value="<%= test ? test.unit || '' : '' %>" placeholder="e.g. mg/dL">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Reference Range Min</label>
        <input type="number" step="any" name="reference_range_min" value="<%= test && test.reference_range_min != null ? test.reference_range_min : '' %>" placeholder="e.g. 0.2">
      </div>
      <div class="form-group">
        <label>Reference Range Max</label>
        <input type="number" step="any" name="reference_range_max" value="<%= test && test.reference_range_max != null ? test.reference_range_max : '' %>" placeholder="e.g. 1.2">
      </div>
    </div>

    <div class="form-group">
      <label>Reference Range Text (shown on reports)</label>
      <input type="text" name="reference_range_text" value="<%= test ? test.reference_range_text || '' : '' %>" placeholder="e.g. 0.2-1.2 mg/dL">
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Price ($) *</label>
        <input type="number" step="0.01" name="price" value="<%= test ? test.price || 0 : '' %>" required placeholder="e.g. 15.00">
      </div>
      <div class="form-group">
        <label>Turnaround Time (hours)</label>
        <input type="number" name="turnaround_hours" value="<%= test ? test.turnaround_hours || 24 : 24 %>" placeholder="e.g. 4">
      </div>
    </div>

    <button type="submit" class="btn btn-primary"><%= test && test.id ? 'Update' : 'Add' %> Test</button>
  </form>
</div>

<%- include('../../partials/footer') %>
