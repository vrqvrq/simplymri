<%- include('../../partials/header') %>

<div class="page-header">
  <h1><%= physician && physician.id ? 'Edit' : 'Add' %> Physician</h1>
  <a href="/physicians" class="btn btn-outline">Back</a>
</div>

<div class="card">
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>
  <form method="POST" action="<%= physician && physician.id ? '/physicians/' + physician.id : '/physicians' %>">
    <div class="form-row">
      <div class="form-group">
        <label>Full Name *</label>
        <input type="text" name="name" value="<%= physician ? physician.name || '' : '' %>" required>
      </div>
      <div class="form-group">
        <label>Specialty</label>
        <input type="text" name="specialty" value="<%= physician ? physician.specialty || '' : '' %>">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Clinic / Hospital</label>
        <input type="text" name="clinic" value="<%= physician ? physician.clinic || '' : '' %>">
      </div>
      <div class="form-group">
        <label>License Number</label>
        <input type="text" name="license_number" value="<%= physician ? physician.license_number || '' : '' %>">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Phone</label>
        <input type="tel" name="phone" value="<%= physician ? physician.phone || '' : '' %>">
      </div>
      <div class="form-group">
        <label>Email</label>
        <input type="email" name="email" value="<%= physician ? physician.email || '' : '' %>">
      </div>
    </div>
    <div class="form-group">
      <label>Notes</label>
      <textarea name="notes" rows="2"><%= physician ? physician.notes || '' : '' %></textarea>
    </div>
    <button type="submit" class="btn btn-primary"><%= physician && physician.id ? 'Update' : 'Add' %> Physician</button>
  </form>
</div>

<%- include('../../partials/footer') %>
