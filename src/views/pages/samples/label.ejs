<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sample Label - <%= sample.sample_id %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { background: white; }
    .label-page { padding: 30px; text-align: center; max-width: 400px; margin: 0 auto; }
    .label-box { border: 2px dashed #ccc; padding: 24px; border-radius: 12px; margin: 20px 0; }
    .label-box h3 { margin-bottom: 12px; font-size: 16px; }
    .label-box img { margin: 12px 0; }
    .patient-info { font-size: 13px; color: #666; margin-top: 8px; line-height: 1.8; }
    .qr-section { margin-top: 16px; }
    @media print {
      .no-print { display: none; }
      .label-box { border: 1px solid #ccc; }
    }
  </style>
</head>
<body>
  <div class="label-page">
    <button class="btn btn-primary no-print" onclick="window.print()">Print Label</button>
    <div class="label-box">
      <h3>SimplyDiagnostic Lab</h3>
      <img src="/codes/barcode/<%= sample.sample_id %>" alt="barcode">
      <div><strong><%= sample.sample_id %></strong></div>
      <div class="patient-info">
        <div><strong><%= sample.first_name %> <%= sample.last_name %></strong> (<%= sample.pid %>)</div>
        <div>DOB: <%= sample.date_of_birth %></div>
        <div>Type: <%= sample.sample_type %></div>
        <div>Order: <%= sample.order_number %></div>
        <div>Collected: <%= sample.collection_date %></div>
      </div>
      <div class="qr-section">
        <img src="/codes/qr/<%= sample.sample_id %>" alt="QR" width="80">
      </div>
    </div>
  </div>
</body>
</html>
