<%- include('../../partials/header') %>

<div class="page-header">
  <h1>Sample Tracking</h1>
</div>

<div class="card">
  <div class="filter-bar">
    <a href="/samples" class="btn btn-sm <%= !status ? 'btn-primary' : 'btn-outline' %>">All</a>
    <a href="/samples?status=collected" class="btn btn-sm <%= status === 'collected' ? 'btn-primary' : 'btn-outline' %>">Collected</a>
    <a href="/samples?status=processing" class="btn btn-sm <%= status === 'processing' ? 'btn-primary' : 'btn-outline' %>">Processing</a>
    <a href="/samples?status=completed" class="btn btn-sm <%= status === 'completed' ? 'btn-primary' : 'btn-outline' %>">Completed</a>
  </div>
</div>

<div class="card">
  <table class="table">
    <thead>
      <tr>
        <th>Sample ID</th>
        <th>Barcode</th>
        <th>Order #</th>
        <th>Patient</th>
        <th>Type</th>
        <th>Collected</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% samples.forEach(function(s) { %>
        <tr>
          <td><strong><%= s.sample_id %></strong></td>
          <td>
            <div class="barcode-section">
              <img src="/codes/barcode/<%= s.sample_id %>" alt="barcode" height="30">
            </div>
          </td>
          <td><a href="/orders/<%= s.order_id %>"><%= s.order_number %></a></td>
          <td><%= s.first_name %> <%= s.last_name %></td>
          <td><%= s.sample_type %></td>
          <td><%= s.collection_date %></td>
          <td><span class="badge badge-<%= s.status %>"><%= s.status %></span></td>
          <td>
            <a href="/codes/label/<%= s.sample_id %>" class="btn btn-sm btn-outline" target="_blank">Label</a>
            <% if (s.status === 'collected') { %>
              <form method="POST" action="/samples/<%= s.id %>/status" style="display:inline">
                <input type="hidden" name="status" value="processing">
                <button type="submit" class="btn btn-sm">Process</button>
              </form>
            <% } else if (s.status === 'processing') { %>
              <form method="POST" action="/samples/<%= s.id %>/status" style="display:inline">
                <input type="hidden" name="status" value="completed">
                <button type="submit" class="btn btn-sm btn-success">Complete</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }); %>
      <% if (samples.length === 0) { %>
        <tr><td colspan="8" class="text-center">No samples found</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../../partials/footer') %>
